# Copia este archivo como .env (junto a manage.py) y ajusta los valores.
# El archivo .env NO se sube al repositorio.

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Si accedes desde otro equipo de la red: DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.50
# DJANGO_CSRF_TRUSTED_ORIGINS=https://192.168.1.50

# PostgreSQL (BVIA-33). Si POSTGRES_DB está vacío se usa SQLite.
POSTGRES_DB=
POSTGRES_USER=biovigia
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
