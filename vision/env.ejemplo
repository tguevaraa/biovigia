# Copia este archivo como vision/.env y ajusta los valores. El .env NO se sube al repositorio.

# Servidor de aplicación (C2) dentro de la red del laboratorio.
BIOVIGIA_SERVIDOR=http://localhost:8000
# Token del servicio: python servidor/manage.py token_vision --box box-2
BIOVIGIA_TOKEN=
BIOVIGIA_BOX=box-2

# Fuente de video: 0 = primera cámara USB; también una ruta de video o rtsp://usuario:clave@ip/...
BIOVIGIA_FUENTE=0

# yolo = modelo entrenado · movimiento = detector de desarrollo sin modelo
BIOVIGIA_DETECTOR=yolo
BIOVIGIA_MODELO=vision/modelos/biovigia-gasa-v0.1.pt

# Valores locales de respaldo. Mientras el servidor responda, manda lo que diga PAN-10.
BIOVIGIA_UMBRAL_CONFIANZA=0.5
BIOVIGIA_VENTANA_S=1.5
BIOVIGIA_K=3
BIOVIGIA_N=5
BIOVIGIA_FPS=15
BIOVIGIA_PERMANENCIA_S=5

# HTTPS en la red interna (RNF-18): true, false o la ruta al certificado de la CA interna.
BIOVIGIA_VERIFICAR_TLS=true

# Clasificador de confirmación de scikit-learn (opcional, joblib).
# BIOVIGIA_CLASIFICADOR=vision/modelos/clasificador.joblib

# Métricas de salud en Amazon CloudWatch (opcional; requiere pip install boto3).
BIOVIGIA_CLOUDWATCH=0
BIOVIGIA_CLOUDWATCH_REGION=us-east-1
